+extern "C" {
+
+EMSCRIPTEN_KEEPALIVE int cardinalweb_ready()
+{
+    CardinalPluginContext* const c = cardinalweb::ctx();
+    return c != nullptr && c->engine != nullptr && c->scene != nullptr ? 1 : 0;
+}
+
+EMSCRIPTEN_KEEPALIVE void cardinalweb_set_ui_hidden(const int hidden)
+{
+    gCardinalWebUiHidden = hidden != 0;
+}
+
+EMSCRIPTEN_KEEPALIVE int cardinalweb_load_patch(const char* const json)
+{
+    CardinalPluginContext* const c = cardinalweb::ctx();
+    if (c == nullptr || json == nullptr)
+        return 0;
+    const std::string path = rack::system::join(rack::system::getTempDirectory(), "cardinalweb-load.vcv");
+    if (FILE* const f = std::fopen(path.c_str(), "w"))
+    {
+        std::fwrite(json, std::strlen(json), 1, f);
+        std::fclose(f);
+    }
+    else
+    {
+        return 0;
+    }
+    const cardinalweb::Ctx sc(c);
+    try {
+        c->patch->loadAction(path);
+        c->scene->rackScroll->reset();
+    } catch (const rack::Exception& e) {
+        d_stderr("cardinalweb_load_patch: %s", e.what());
+        return 0;
+    }
+    return 1;
+}
+
+EMSCRIPTEN_KEEPALIVE const char* cardinalweb_get_patch_json()
+{
+    CardinalPluginContext* const c = cardinalweb::ctx();
+    if (c == nullptr) return "null";
+    const cardinalweb::Ctx sc(c);
+    return cardinalweb::result(c->patch->toJson());
+}
