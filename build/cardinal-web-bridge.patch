+EMSCRIPTEN_KEEPALIVE const char* cardinalweb_get_cables_json()
+{
+    CardinalPluginContext* const c = cardinalweb::ctx();
+    if (c == nullptr) return "[]";
+    const cardinalweb::Ctx sc(c);
+    json_t* const arr = json_array();
+    for (const int64_t id : c->engine->getCableIds())
+    {
+        rack::engine::Cable* const cable = c->engine->getCable(id);
+        if (cable == nullptr || cable->inputModule == nullptr || cable->outputModule == nullptr) continue;
+        json_t* const jc = json_object();
+        json_object_set_new(jc, "id", json_integer(id));
+        json_object_set_new(jc, "outputModuleId", json_integer(cable->outputModule->id));
+        json_object_set_new(jc, "outputId", json_integer(cable->outputId));
+        json_object_set_new(jc, "inputModuleId", json_integer(cable->inputModule->id));
+        json_object_set_new(jc, "inputId", json_integer(cable->inputId));
+        json_array_append_new(arr, jc);
+    }
+    return cardinalweb::result(arr);
+}
