+// Connect an output to an input the way the stock UI does (a CableWidget owning an engine Cable).
+// An input already in use is cleared first. Returns the new cable id, or -1.
+EMSCRIPTEN_KEEPALIVE double cardinalweb_add_cable(const double outModuleId, const int outPortId, const double inModuleId, const int inPortId)
+{
+    CardinalPluginContext* const c = cardinalweb::ctx();
+    if (c == nullptr) return -1;
+    const cardinalweb::Ctx sc(c);
+    rack::app::ModuleWidget* const outMw = c->scene->rack->getModule(int64_t(outModuleId));
+    rack::app::ModuleWidget* const inMw = c->scene->rack->getModule(int64_t(inModuleId));
+    if (outMw == nullptr || inMw == nullptr) return -1;
+    rack::app::PortWidget* const outPw = outMw->getOutput(outPortId);
+    rack::app::PortWidget* const inPw = inMw->getInput(inPortId);
+    if (outPw == nullptr || inPw == nullptr) return -1;
+    c->scene->rack->clearCablesOnPort(inPw);
+    rack::app::CableWidget* const cw = new rack::app::CableWidget;
+    cw->outputPort = outPw;
+    cw->inputPort = inPw;
+    cw->color = c->scene->rack->getNextCableColor();
+    cw->updateCable();
+    c->scene->rack->addCable(cw);
+    if (cw->getCable() != nullptr)
+    {
+        rack::history::CableAdd* const h = new rack::history::CableAdd;
+        h->name = "connect cable";
+        h->setCable(cw);
+        c->history->push(h);
+        return double(cw->getCable()->id);
+    }
+    return -1;
+}
+
+EMSCRIPTEN_KEEPALIVE int cardinalweb_remove_cable(const double cableId)
+{
+    CardinalPluginContext* const c = cardinalweb::ctx();
+    if (c == nullptr) return 0;
+    const cardinalweb::Ctx sc(c);
+    rack::app::CableWidget* const cw = c->scene->rack->getCable(int64_t(cableId));
+    if (cw == nullptr) return 0;
+    rack::history::CableRemove* const h = new rack::history::CableRemove;
+    h->name = "disconnect cable";
+    h->setCable(cw);
+    c->history->push(h);
+    c->scene->rack->removeCable(cw);
+    delete cw;
+    return 1;
+}
+
+// Record a finished parameter gesture so it can be undone (the value itself was set live with set_param).
+EMSCRIPTEN_KEEPALIVE void cardinalweb_param_commit(const double moduleId, const int paramId, const float oldValue, const float newValue)
+{
+    CardinalPluginContext* const c = cardinalweb::ctx();
+    if (c == nullptr || oldValue == newValue) return;
+    rack::engine::Module* const m = c->engine->getModule(int64_t(moduleId));
+    if (m == nullptr || paramId < 0 || paramId >= int(m->paramQuantities.size())) return;
+    const cardinalweb::Ctx sc(c);
+    rack::history::ParamChange* const h = new rack::history::ParamChange;
+    h->name = "change parameter";
+    h->moduleId = int64_t(moduleId);
+    h->paramId = paramId;
+    h->oldValue = oldValue;
+    h->newValue = newValue;
+    c->history->push(h);
+}
+
+EMSCRIPTEN_KEEPALIVE int cardinalweb_can_undo() { CardinalPluginContext* const c = cardinalweb::ctx(); return c != nullptr && c->history->canUndo() ? 1 : 0; }
+EMSCRIPTEN_KEEPALIVE int cardinalweb_can_redo() { CardinalPluginContext* const c = cardinalweb::ctx(); return c != nullptr && c->history->canRedo() ? 1 : 0; }
+EMSCRIPTEN_KEEPALIVE const char* cardinalweb_undo_name() { CardinalPluginContext* const c = cardinalweb::ctx(); if (c == nullptr || !c->history->canUndo()) return ""; cardinalweb::gResult = c->history->getUndoName(); return cardinalweb::gResult.c_str(); }
+EMSCRIPTEN_KEEPALIVE const char* cardinalweb_redo_name() { CardinalPluginContext* const c = cardinalweb::ctx(); if (c == nullptr || !c->history->canRedo()) return ""; cardinalweb::gResult = c->history->getRedoName(); return cardinalweb::gResult.c_str(); }
+
+EMSCRIPTEN_KEEPALIVE int cardinalweb_undo()
+{
+    CardinalPluginContext* const c = cardinalweb::ctx();
+    if (c == nullptr || !c->history->canUndo()) return 0;
+    const cardinalweb::Ctx sc(c);
+    try { c->history->undo(); } catch (const rack::Exception& e) { d_stderr("cardinalweb_undo: %s", e.what()); return 0; }
+    return 1;
+}
+
+EMSCRIPTEN_KEEPALIVE int cardinalweb_redo()
+{
+    CardinalPluginContext* const c = cardinalweb::ctx();
+    if (c == nullptr || !c->history->canRedo()) return 0;
+    const cardinalweb::Ctx sc(c);
+    try { c->history->redo(); } catch (const rack::Exception& e) { d_stderr("cardinalweb_redo: %s", e.what()); return 0; }
+    return 1;
+}
