+// -----------------------------------------------------------------------------------------------------------
+// cardinal-web bridge: a small C API for a page-side UI (docs/12). Only on the web build.
+
+#ifdef DISTRHO_OS_WASM
+namespace cardinalweb {
+
+struct WatchItem { int64_t moduleId; int kind; int index; }; // kind: 0 input, 1 output, 2 light, 3 param
+static std::vector<WatchItem> gWatch;
+static std::string gResult;
+
+static CardinalPluginContext* ctx()
+{
+    return gCardinalWebUI != nullptr ? gCardinalWebUI->context : nullptr;
+}
+
+struct Ctx {
+    CardinalPluginContext* const c;
+    Ctx(CardinalPluginContext* const c_) : c(c_) { rack::contextSet(c); }
+    ~Ctx() { rack::contextSet(nullptr); }
+};
+
+static const char* result(json_t* const j)
+{
+    if (char* const s = json_dumps(j, JSON_COMPACT))
+    {
+        gResult = s;
+        std::free(s);
+    }
+    else
+    {
+        gResult = "null";
+    }
+    json_decref(j);
+    return gResult.c_str();
+}
+
+} // namespace cardinalweb
