+EMSCRIPTEN_KEEPALIVE const char* cardinalweb_get_modules_json()
+{
+    CardinalPluginContext* const c = cardinalweb::ctx();
+    if (c == nullptr) return "[]";
+    const cardinalweb::Ctx sc(c);
+    json_t* const arr = json_array();
+    for (const int64_t id : c->engine->getModuleIds())
+    {
+        rack::engine::Module* const m = c->engine->getModule(id);
+        if (m == nullptr || m->model == nullptr) continue;
+        json_t* const jm = json_object();
+        json_object_set_new(jm, "id", json_integer(id));
+        json_object_set_new(jm, "plugin", json_string(m->model->plugin->slug.c_str()));
+        json_object_set_new(jm, "model", json_string(m->model->slug.c_str()));
+        json_object_set_new(jm, "name", json_string(m->model->name.c_str()));
+        json_object_set_new(jm, "description", json_string(m->model->description.c_str()));
+        json_object_set_new(jm, "bypassed", json_boolean(m->isBypassed()));
+        if (rack::app::ModuleWidget* const mw = c->scene->rack->getModule(id))
+        {
+            json_t* const pos = json_array();
+            json_array_append_new(pos, json_real(mw->box.pos.x / rack::app::RACK_GRID_WIDTH));
+            json_array_append_new(pos, json_real(mw->box.pos.y / rack::app::RACK_GRID_HEIGHT));
+            json_object_set_new(jm, "pos", pos);
+            json_object_set_new(jm, "hp", json_integer(int(std::round(mw->box.size.x / rack::app::RACK_GRID_WIDTH))));
+        }
+        json_t* const params = json_array();
+        for (size_t i = 0; i < m->paramQuantities.size(); ++i)
+        {
+            rack::engine::ParamQuantity* const pq = m->paramQuantities[i];
+            if (pq == nullptr) continue;
+            json_t* const jp = json_object();
+            json_object_set_new(jp, "id", json_integer(i));
+            json_object_set_new(jp, "name", json_string(pq->name.c_str()));
+            json_object_set_new(jp, "unit", json_string(pq->getUnit().c_str()));
+            json_object_set_new(jp, "description", json_string(pq->getDescription().c_str()));
+            json_object_set_new(jp, "min", json_real(pq->minValue));
+            json_object_set_new(jp, "max", json_real(pq->maxValue));
+            json_object_set_new(jp, "default", json_real(pq->defaultValue));
+            json_object_set_new(jp, "value", json_real(pq->getValue()));
+            json_object_set_new(jp, "display", json_string(pq->getDisplayValueString().c_str()));
+            json_object_set_new(jp, "snap", json_boolean(pq->snapEnabled));
+            json_object_set_new(jp, "switch", json_boolean(dynamic_cast<rack::engine::SwitchQuantity*>(pq) != nullptr));
+            if (rack::engine::SwitchQuantity* const sq = dynamic_cast<rack::engine::SwitchQuantity*>(pq))
+            {
+                json_t* const labels = json_array();
+                for (const std::string& l : sq->labels) json_array_append_new(labels, json_string(l.c_str()));
+                json_object_set_new(jp, "labels", labels);
+            }
+            json_array_append_new(params, jp);
+        }
+        json_object_set_new(jm, "params", params);
+        json_t* const ins = json_array();
+        for (size_t i = 0; i < m->inputInfos.size(); ++i)
+        {
+            rack::engine::PortInfo* const pi = m->inputInfos[i];
+            json_t* const jp = json_object();
+            json_object_set_new(jp, "id", json_integer(i));
+            json_object_set_new(jp, "name", json_string(pi != nullptr ? pi->name.c_str() : ""));
+            json_object_set_new(jp, "description", json_string(pi != nullptr ? pi->description.c_str() : ""));
+            json_object_set_new(jp, "connected", json_boolean(m->inputs[i].isConnected()));
+            json_array_append_new(ins, jp);
+        }
+        json_object_set_new(jm, "inputs", ins);
+        json_t* const outs = json_array();
+        for (size_t i = 0; i < m->outputInfos.size(); ++i)
+        {
+            rack::engine::PortInfo* const pi = m->outputInfos[i];
+            json_t* const jp = json_object();
+            json_object_set_new(jp, "id", json_integer(i));
+            json_object_set_new(jp, "name", json_string(pi != nullptr ? pi->name.c_str() : ""));
+            json_object_set_new(jp, "description", json_string(pi != nullptr ? pi->description.c_str() : ""));
+            json_object_set_new(jp, "connected", json_boolean(m->outputs[i].isConnected()));
+            json_array_append_new(outs, jp);
+        }
+        json_object_set_new(jm, "outputs", outs);
+        json_object_set_new(jm, "lights", json_integer(int(m->lights.size())));
+        json_array_append_new(arr, jm);
+    }
+    return cardinalweb::result(arr);
+}
