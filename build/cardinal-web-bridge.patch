+// json: [[moduleId, kind, index], ...]  kind: 0 input voltage, 1 output voltage, 2 light brightness, 3 param value
+EMSCRIPTEN_KEEPALIVE int cardinalweb_watch(const char* const json)
+{
+    cardinalweb::gWatch.clear();
+    json_error_t err;
+    json_t* const arr = json_loads(json, 0, &err);
+    if (arr == nullptr || !json_is_array(arr)) { if (arr) json_decref(arr); return 0; }
+    size_t i; json_t* item;
+    json_array_foreach(arr, i, item)
+    {
+        if (!json_is_array(item) || json_array_size(item) < 3) continue;
+        cardinalweb::WatchItem w;
+        w.moduleId = int64_t(json_number_value(json_array_get(item, 0)));
+        w.kind = int(json_integer_value(json_array_get(item, 1)));
+        w.index = int(json_integer_value(json_array_get(item, 2)));
+        cardinalweb::gWatch.push_back(w);
+    }
+    json_decref(arr);
+    return int(cardinalweb::gWatch.size());
+}
+
+EMSCRIPTEN_KEEPALIVE int cardinalweb_read_watched(float* const out, const int max)
+{
+    CardinalPluginContext* const c = cardinalweb::ctx();
+    if (c == nullptr) return 0;
+    const int n = std::min(max, int(cardinalweb::gWatch.size()));
+    int64_t lastId = -1; rack::engine::Module* m = nullptr;
+    for (int i = 0; i < n; ++i)
+    {
+        const cardinalweb::WatchItem& w = cardinalweb::gWatch[i];
+        if (w.moduleId != lastId) { m = c->engine->getModule(w.moduleId); lastId = w.moduleId; }
+        float v = 0.f;
+        if (m != nullptr)
+        {
+            switch (w.kind)
+            {
+            case 0: if (w.index >= 0 && w.index < int(m->inputs.size())) v = m->inputs[w.index].getVoltage(); break;
+            case 1: if (w.index >= 0 && w.index < int(m->outputs.size())) v = m->outputs[w.index].getVoltage(); break;
+            case 2: if (w.index >= 0 && w.index < int(m->lights.size())) v = m->lights[w.index].getBrightness(); break;
+            case 3: if (w.index >= 0 && w.index < int(m->params.size())) v = m->params[w.index].getValue(); break;
+            }
+        }
+        out[i] = v;
+    }
+    return n;
+}
