+EMSCRIPTEN_KEEPALIVE void cardinalweb_set_param(const double moduleId, const int paramId, const float value)
+{
+    CardinalPluginContext* const c = cardinalweb::ctx();
+    if (c == nullptr) return;
+    rack::engine::Module* const m = c->engine->getModule(int64_t(moduleId));
+    if (m == nullptr || paramId < 0 || paramId >= int(m->paramQuantities.size())) return;
+    rack::engine::ParamQuantity* const pq = m->paramQuantities[paramId];
+    const float v = pq != nullptr ? rack::math::clamp(value, std::min(pq->minValue, pq->maxValue), std::max(pq->minValue, pq->maxValue)) : value;
+    c->engine->setParamValue(m, paramId, v);
+}
+
+EMSCRIPTEN_KEEPALIVE float cardinalweb_get_param(const double moduleId, const int paramId)
+{
+    CardinalPluginContext* const c = cardinalweb::ctx();
+    if (c == nullptr) return 0.f;
+    rack::engine::Module* const m = c->engine->getModule(int64_t(moduleId));
+    if (m == nullptr || paramId < 0 || paramId >= int(m->params.size())) return 0.f;
+    return c->engine->getParamValue(m, paramId);
+}
+
+EMSCRIPTEN_KEEPALIVE const char* cardinalweb_get_param_display(const double moduleId, const int paramId)
+{
+    CardinalPluginContext* const c = cardinalweb::ctx();
+    if (c == nullptr) return "";
+    const cardinalweb::Ctx sc(c);
+    rack::engine::Module* const m = c->engine->getModule(int64_t(moduleId));
+    if (m == nullptr || paramId < 0 || paramId >= int(m->paramQuantities.size()) || m->paramQuantities[paramId] == nullptr) return "";
+    cardinalweb::gResult = m->paramQuantities[paramId]->getDisplayValueString();
+    return cardinalweb::gResult.c_str();
+}
