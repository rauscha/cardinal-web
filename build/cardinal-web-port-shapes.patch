+// cardinal-web: shape-code jacks by signal type (docs/11 §5). Original SVGs
+// live in res/ComponentLibrary; sizes are kept so layouts do not move.
+static void cardinalWebShapePort(PortWidget* const port)
+{
+	SvgPort* const sp = dynamic_cast<SvgPort*>(port);
+	if (sp == nullptr || port->module == nullptr)
+		return;
+	engine::PortInfo* const info = port->getPortInfo();
+	if (info == nullptr || info->name.empty())
+		return;
+	const std::string n = string::uppercase(info->name);
+	const char* file = nullptr;
+	if (n.find("CLOCK") != std::string::npos || n.find("CLK") != std::string::npos)
+		file = "res/ComponentLibrary/PortClock.svg";
+	else if (n.find("GATE") != std::string::npos || n.find("TRIG") != std::string::npos || n.find("RUN") != std::string::npos
+	      || n.find("RESET") != std::string::npos || n.find("RST") != std::string::npos || n.find("SYNC") != std::string::npos)
+		file = "res/ComponentLibrary/PortGate.svg";
+	else if (n.find("V/OCT") != std::string::npos || n.find("PITCH") != std::string::npos || n.find("1V/O") != std::string::npos)
+		file = "res/ComponentLibrary/PortPitch.svg";
+	if (file == nullptr)
+		return;
+	const math::Vec center = port->box.getCenter();
+	sp->setSvg(window::Svg::load(asset::system(file)));
+	port->box.pos = center.minus(port->box.size.div(2));
+}
