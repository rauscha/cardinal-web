+// ---------------------------------------------------------------------------
+// Touch input (cardinal-web). Replaces the stock single-pointer emulation.
+//
+//  one finger:  tap            -> left click at the touch origin
+//               move > slop    -> left press at origin, then drag
+//               hold 450 ms    -> right click (press + release) at origin,
+//                                 then the finger hovers the opened menu;
+//                                 lift after sliding -> left click where lifted
+//  two fingers: midpoint move  -> scroll (Rack pans)
+//               distance ratio -> ctrl-scroll (Rack zooms at the midpoint)
+// ---------------------------------------------------------------------------
+
+#define PUGL_TOUCH_LONGPRESS_MS 450
+#define PUGL_TOUCH_SLOP_PX      10.0
+#define PUGL_TOUCH_PAN_DIV      50.0   // Cardinal multiplies scroll deltas by 50
+#define PUGL_TOUCH_ZOOM_MULT    4.0    // Rack: zoom *= 2^(scrollDelta.y / 50 / 4)
+
+enum PuglTouchState {
+  PUGL_TOUCH_NONE = 0,
+  PUGL_TOUCH_PENDING,   // one finger down, inside slop, long-press timer running
+  PUGL_TOUCH_DRAGGING,  // left button is down
+  PUGL_TOUCH_MENU,      // right click was delivered, finger still down
+  PUGL_TOUCH_MULTI,     // two fingers: pan / zoom gesture
+  PUGL_TOUCH_DONE       // gesture over, waiting for all fingers to lift
+};
+
+typedef struct {
+  int    id;
+  double x, y; // canvas CSS pixels
+} PuglTouchPoint;
+
+static void
+puglTouchSendButton(PuglView* const view, const int button, const bool press,
+                    const double x, const double y, const double time, const PuglMods state)
+{
+  const double sf = view->world->impl->scaleFactor;
+  PuglEvent event = {{press ? PUGL_BUTTON_PRESS : PUGL_BUTTON_RELEASE, 0}};
+  event.button.time   = time;
+  event.button.button = button;
+  event.button.x      = x * sf;
+  event.button.y      = y * sf;
+  event.button.xRoot  = x * sf;
+  event.button.yRoot  = y * sf;
+  event.button.state  = state;
+  puglDispatchEventWithContext(view, &event);
+}
+
+static void
+puglTouchSendMotion(PuglView* const view, const double x, const double y,
+                    const double time, const PuglMods state)
+{
+  const double sf = view->world->impl->scaleFactor;
+  PuglEvent event = {{PUGL_MOTION, 0}};
+  event.motion.time  = time;
+  event.motion.x     = x * sf;
+  event.motion.y     = y * sf;
+  event.motion.xRoot = x * sf;
+  event.motion.yRoot = y * sf;
+  event.motion.state = state;
+  puglDispatchEventWithContext(view, &event);
+}
+
+static void
+puglTouchSendScroll(PuglView* const view, const double x, const double y,
+                    const double dx, const double dy, const bool ctrl, const double time)
+{
+  const double sf = view->world->impl->scaleFactor;
+  PuglEvent event = {{PUGL_SCROLL, 0}};
+  event.scroll.time      = time;
+  event.scroll.x         = x * sf;
+  event.scroll.y         = y * sf;
+  event.scroll.xRoot     = x * sf;
+  event.scroll.yRoot     = y * sf;
+  event.scroll.state     = ctrl ? PUGL_MOD_CTRL : 0;
+  event.scroll.direction = PUGL_SCROLL_SMOOTH;
+  event.scroll.dx        = dx;
+  event.scroll.dy        = dy;
+  puglDispatchEventWithContext(view, &event);
+}
+
+static void
+puglTouchClearTimer(PuglInternals* const impl)
+{
+  if (impl->buttonPressTimeout != -1) {
+    emscripten_clear_timeout(impl->buttonPressTimeout);
+    impl->buttonPressTimeout = -1;
+  }
+}
