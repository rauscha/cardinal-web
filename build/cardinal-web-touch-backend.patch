+  impl->touchState     = PUGL_TOUCH_MENU;
+  impl->touchMenuMoved = false;
+
+  const double time = impl->touchStartTime + PUGL_TOUCH_LONGPRESS_MS / 1e3;
+  puglTouchSendButton(view, 1, true,  impl->touchOriginX, impl->touchOriginY, time, 0);
+  puglTouchSendButton(view, 1, false, impl->touchOriginX, impl->touchOriginY, time, 0);
+
+  EM_ASM({
+    try { if (navigator.vibrate) navigator.vibrate(15); } catch (e) {}
+  });
+}
+
+static void
+puglTouchInitMulti(PuglInternals* const impl, const PuglTouchPoint* const a, const PuglTouchPoint* const b)
+{
+  impl->touchMidX = (a->x + b->x) * 0.5;
+  impl->touchMidY = (a->y + b->y) * 0.5;
+  const double ddx = a->x - b->x;
+  const double ddy = a->y - b->y;
+  impl->touchDist = sqrt(ddx * ddx + ddy * ddy);
 }
 
